# Copy this to .streamlit/secrets.toml and fill in your Yahoo app credentials.
# Create a Yahoo app at: https://developer.yahoo.com/apps/create/
# Set the redirect URI to your Streamlit Cloud app URL.
# secrets.toml is in .gitignore — never commit it.

[yahoo]
client_id = "your_yahoo_client_id"
client_secret = "your_yahoo_client_secret"
redirect_uri = "https://your-app-name.streamlit.app"
